  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0 <3"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.7",
    "@types/node": "^24.0.0",
    "@types/tar-stream": "^3.1.4",
    "typescript": "^5.9.3"
  }
}
