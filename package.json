{
  "name": "opencode-selectel-models",
  "version": "1.1.0",
  "description": "Selectel models catalog sync plugin for OpenCode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perminovsi/opencode-selectel-models.git"
  },
  "type": "module",
  "exports": {
    ".": "./server.ts",
